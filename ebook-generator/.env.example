# Copia este archivo a ".env" y completa tu clave real.
# Consíguela en https://console.anthropic.com/settings/keys

ANTHROPIC_API_KEY=sk-ant-...

# Opcional: modelo a usar. Por defecto usa claude-opus-5 (mejor calidad de
# escritura). Si quieres generar ebooks más rápido y más barato, cambia a
# claude-sonnet-5.
# ANTHROPIC_MODEL=claude-opus-5

# Opcional: puerto del servidor local (por defecto 4790).
# PORT=4790

# Opcional: solo si Playwright no logra descargar Chromium automáticamente,
# apunta aquí a un binario de Chrome/Chromium ya instalado en el sistema.
# CHROMIUM_EXECUTABLE_PATH=/usr/bin/chromium
